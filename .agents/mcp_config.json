{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ]
    },
    "fetch": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-fetch"
      ]
    },
    "git": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-server-git",
        "--repository",
        "."
      ]
    },
    "magic-ui": {
      "command": "npx",
      "args": [
        "-y",
        "@21st-dev/magic-mcp"
      ]
    },
    "codebase-memory": {
      "command": "npx",
      "args": [
        "-y",
        "codebase-memory-mcp"
      ]
    }
  }
}
