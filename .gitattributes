# Auto detect text files and perform LF normalization
* text=auto

# PDF cross-reference tables use byte offsets; checkout must preserve the bytes.
*.pdf binary

# Upstream asset licenses are hash-pinned; preserve their downloaded bytes.
windows/src/workspace/assets/*-*.txt text eol=lf
windows/src/workspace/assets/*.ttf binary

# Windows batch files need CRLF in the working tree.
*.cmd text eol=crlf

# Candidate inventory hashes identify exact LF report bytes on all hosts.
integrations/mkr-music/engine/runtime-evidence.json text eol=lf
integrations/mkr-music/source-artifact-evidence.json text eol=lf
